<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/weatherImage"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginStart="275dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="275dp"
        android:layout_marginBottom="982dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <!-- Latitude -->
    <TextView
        android:id="@+id/labelLat"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="322dp"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="902dp"
        android:gravity="center_vertical"
        android:text="@string/latitude"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editLat"
        android:textColor="?android:textColor"
        android:textColorHint="?android:textColor"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="400dp"
        android:layout_marginTop="322dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="902dp"
        android:inputType="numberDecimal|numberSigned"
        android:text="38.76"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Longitude -->
    <TextView
        android:id="@+id/labelLon"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="386dp"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="838dp"
        android:gravity="center_vertical"
        android:text="@string/longitude"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editLon"
        android:textColor="?android:textColor"
        android:textColorHint="?android:textColor"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="400dp"
        android:layout_marginTop="386dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="838dp"
        android:inputType="numberDecimal|numberSigned"
        android:text="-9.12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sea Level Pressure -->
    <TextView
        android:id="@+id/labelPressure"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="450dp"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="774dp"
        android:gravity="center_vertical"
        android:text="@string/sea_level_pressure"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pressureValue"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="400dp"
        android:layout_marginTop="450dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="774dp"
        android:gravity="center_vertical"
        android:text="-"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Wind Direction -->
    <TextView
        android:id="@+id/labelWindDir"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="514dp"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="710dp"
        android:gravity="center_vertical"
        android:text="@string/wind_direction"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/windDirValue"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="400dp"
        android:layout_marginTop="514dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="710dp"
        android:gravity="center_vertical"
        android:text="-"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Wind Speed -->
    <TextView
        android:id="@+id/labelWindSpeed"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="578dp"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="646dp"
        android:gravity="center_vertical"
        android:text="@string/wind_speed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/windSpeedValue"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="400dp"
        android:layout_marginTop="578dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="646dp"
        android:gravity="center_vertical"
        android:text="-"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Temperature -->
    <TextView
        android:id="@+id/labelTemp"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="642dp"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="582dp"
        android:gravity="center_vertical"
        android:text="@string/temperature"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tempValue"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="400dp"
        android:layout_marginTop="642dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="582dp"
        android:gravity="center_vertical"
        android:text="-"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Time -->
    <TextView
        android:id="@+id/labelTime"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="706dp"
        android:layout_marginEnd="400dp"
        android:layout_marginBottom="518dp"
        android:gravity="center_vertical"
        android:text="@string/time"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/timeValue"
        android:layout_width="368dp"
        android:layout_height="56dp"
        android:layout_marginStart="400dp"
        android:layout_marginTop="706dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="518dp"
        android:gravity="center_vertical"
        android:text="-"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botão UPDATE -->
    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="342dp"
        android:layout_marginTop="794dp"
        android:layout_marginEnd="342dp"
        android:layout_marginBottom="438dp"
        android:text="@string/update"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>