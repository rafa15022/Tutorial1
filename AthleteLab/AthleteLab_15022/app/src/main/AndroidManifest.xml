<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AthleteLabApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_athletelab"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_athletelab"
        android:supportsRtl="true"
        android:theme="@style/Theme.AthleteLab">

        <activity android:name=".ui.AddWorkoutActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".auth.AuthActivity" android:exported="false" />
        <activity android:name=".ui.PostEditorActivity" android:exported="false" />
        <activity android:name=".ui.EditProfileActivity" />
        <activity android:name=".ui.HelpActivity" />
        <activity android:name=".ui.AboutActivity" />
        <activity android:name=".ui.PhoneVerifyActivity" />
        <activity android:name=".ui.SettingsActivity" />
        <activity android:name=".ui.LandingActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
