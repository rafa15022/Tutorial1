<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CoolWeatherApp" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.CoolWeatherApp" parent="Base.Theme.CoolWeatherApp">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="background">@color/viewBG</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Telemóvel -->
    <style name="Theme.Day" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundao</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="Theme.Day.Land" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundaodeitado</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="Theme.Night" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundaonoite</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Theme.Night.Land" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundaonoitedeitado</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Tablet -->
    <style name="Theme.Day.Tablet" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundaotablet</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="Theme.Day.Tablet.Land" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundaotabletdeitado</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="Theme.Night.Tablet" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundaotabletnoite</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Theme.Night.Tablet.Land" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundaotabletdeitadonoite</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>